# Copy to .env (gitignored) and fill in. Never commit .env.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Standard mode keeps your content out of training. Contributor mode is
# about 12x cheaper but lets Meta train on everything sent.
MUSE_SPARK_MODEL=muse-spark-1.3

# Muse Spark Open on Baseten (hackathon key works only with this model)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Fireworks (serverless inference, fine-tuning of Meta open models)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open
